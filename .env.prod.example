# 운영 .env. 서버에서 cp .env.prod.example .env 한 뒤 채운다. 저장소에 올리지 않는다.
SITE_ADDRESS=campus-alimi.duckdns.org
POSTGRES_PASSWORD=change-me-long-random
ADMIN_EMAIL=you@example.com

# 메모리 1GB 서버(E2.1.Micro)일 때만 주석을 푼다. A1(12GB)은 기본값으로 충분하다.
# JAVA_TOOL_OPTIONS=-Xmx256m -XX:MaxMetaspaceSize=128m -Xss512k -XX:+UseSerialGC -Duser.timezone=Asia/Seoul

# 메일. 처음엔 console(링크가 docker logs에 찍힘). Gmail 앱 비밀번호가 준비되면 smtp.
MAIL_MODE=console
MAIL_FROM=
SMTP_USER=
SMTP_PASSWORD=
